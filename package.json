{
  "name": "qa-automation-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "UI + API test automation with Playwright and TypeScript against public demo apps.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --project=ui --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20.12" },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
